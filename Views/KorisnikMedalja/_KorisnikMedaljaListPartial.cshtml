@model IEnumerable<planinarenje.Models.KorisnikMedaljaIndexViewModel>

@if (!Model.Any())
{
    <div class="app-card">
        <h2 class="h5 mb-2">Nema dodijeljenih medalja</h2>
        <p class="text-muted mb-0">Trenutno nisu pronađeni podatci za prikaz.</p>
    </div>
}
else
{
    <div class="app-card table-responsive p-0">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th class="ps-4">Planinar</th>
                    <th>Medalja</th>
                    <th>Datum dodjele</th>
                    <th>Napomena</th>
                    <th class="text-end pe-4">Akcije</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr data-id="@item.IdKorisnikMedalja">
                        <td class="ps-4">@item.ImePrezimeKorisnika</td>
                        <td>@item.NazivMedalje</td>
                        <td>@item.DatumDodjele.ToString("dd.MM.yyyy.")</td>
                        <td>@(string.IsNullOrWhiteSpace(item.Napomena) ? "-" : item.Napomena)</td>
                        <td class="text-end pe-4">
                            <a asp-action="Details" asp-route-id="@item.IdKorisnikMedalja" class="btn btn-sm btn-outline-primary">Detalji</a>
                            <a asp-action="Edit" asp-route-id="@item.IdKorisnikMedalja" class="btn btn-sm btn-outline-secondary">Uredi</a>
                            <a asp-action="Delete" asp-route-id="@item.IdKorisnikMedalja" class="btn btn-sm btn-outline-danger">Obrisi</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
