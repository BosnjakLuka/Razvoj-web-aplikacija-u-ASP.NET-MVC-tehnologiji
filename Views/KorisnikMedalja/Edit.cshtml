@model planinarenje.Models.ViewModels.KorisnikMedaljaEditModel

<section class="mb-4">
    <h1 class="section-title mb-2">Uredi dodjelu</h1>
    <p class="text-muted mb-0">Azurirajte podatke o dodjeli medalje.</p>
</section>

<div class="app-card">
    <form asp-action="Edit" method="post">
        <div class="row">
            <div class="col-md-6 mb-3">
                <label asp-for="IdKorisnik" class="form-label">Korisnik</label>
                @await Html.PartialAsync("_AutocompleteDropdown", null, new ViewDataDictionary(ViewData)
                {
                    { "FieldName", "IdKorisnik" },
                    { "DisplayName", "Korisnik" },
                    { "SearchUrl", Url.Action("AutocompleteSearch", "Korisnik") },
                    { "CurrentId", Model?.IdKorisnik.ToString() },
                    { "CurrentText", ViewData["KorisnikText"]?.ToString() },
                    { "Placeholder", "Pretrazi korisnike..." },
                    { "IsRequired", true }
                })
            </div>
            <div class="col-md-6 mb-3">
                <label asp-for="IdMedalja" class="form-label">Medalja</label>
                @await Html.PartialAsync("_AutocompleteDropdown", null, new ViewDataDictionary(ViewData)
                {
                    { "FieldName", "IdMedalja" },
                    { "DisplayName", "Medalja" },
                    { "SearchUrl", Url.Action("AutocompleteSearch", "Medalja") },
                    { "CurrentId", Model?.IdMedalja.ToString() },
                    { "CurrentText", ViewData["MedaljaText"]?.ToString() },
                    { "Placeholder", "Pretrazi medalje..." },
                    { "IsRequired", true }
                })
            </div>
        </div>
        <div class="mb-3">
            @await Html.PartialAsync("_DateTimePicker", null, new ViewDataDictionary(ViewData)
            {
                { "FieldName", "DatumDodjele" },
                { "Label", "Datum dodjele" },
                { "Value", Model.DatumDodjele.ToString("o") },
                { "IncludeTime", true },
                { "Required", true }
            })
        </div>
        <div class="mb-3">
            <label asp-for="Napomena" class="form-label"></label>
            <textarea asp-for="Napomena" class="form-control" rows="3"></textarea>
            <span asp-validation-for="Napomena" class="text-danger small"></span>
        </div>
        <div class="d-flex gap-2">
            <button type="submit" class="btn btn-primary">Spremi</button>
            <a asp-action="Index" class="btn btn-outline-secondary">Odustani</a>
        </div>
    </form>
</div>
