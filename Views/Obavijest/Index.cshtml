@model IReadOnlyList<planinarenje.Entiteti.Obavijest>

@{
    ViewData["Title"] = "Obavijesti";
}

@section Breadcrumbs {
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb mb-0">
            <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Naslovnica</a></li>
            <li class="breadcrumb-item active" aria-current="page">Obavijesti</li>
        </ol>
    </nav>
}

<section class="mb-4">
    <h1 class="section-title mb-3">Obavijesti</h1>
    <p class="text-muted mb-0">
        Službene obavijesti i novosti u aplikaciji.
    </p>
</section>

@if (!Model.Any())
{
    <div class="app-card">
        <h2 class="h5 mb-2">Nema dostupnih obavijesti</h2>
        <p class="text-muted mb-0">Trenutno nisu pronađene obavijesti za prikaz.</p>
    </div>
}
else
{
    <section class="row g-4">
        @foreach (var obavijest in Model)
        {
            <article class="col-12 col-md-6 col-xl-4">
                <div class="app-card h-100 d-flex flex-column">
                    <div class="d-flex align-items-start justify-content-between gap-3 mb-3">
                        <h2 class="h5 mb-0">@obavijest.Naslov</h2>
                        <span class="app-badge badge-subtle text-uppercase">
                            @(obavijest.JeAktivna ? "Aktivna" : "Neaktivna")
                        </span>
                    </div>

                    <div class="d-flex flex-wrap gap-2 mb-3">
                        <span class="app-badge badge-subtle text-uppercase">
                            @obavijest.DatumObjave.ToString("dd.MM.yyyy.")
                        </span>
                        <span class="app-badge badge-subtle text-uppercase">
                            @(obavijest.Korisnik != null ? $"{obavijest.Korisnik.Ime} {obavijest.Korisnik.Prezime}" : "Nepoznato")
                        </span>
                    </div>

                    @if (!string.IsNullOrWhiteSpace(obavijest.Sadrzaj))
                    {
                        <p class="text-muted mb-4 flex-grow-1">@TrimOpis(obavijest.Sadrzaj, 150)</p>
                    }
                    else
                    {
                        <p class="text-muted mb-4 flex-grow-1 fst-italic">Sadržaj obavijesti nije dostupan.</p>
                    }

                    <div class="mt-auto d-grid">
                        <a asp-controller="Obavijest"
                           asp-action="Details"
                           asp-route-id="@obavijest.IdObavijest"
                           class="btn btn-primary">
                            Detalji obavijesti
                        </a>
                    </div>
                </div>
            </article>
        }
    </section>
}

@functions {
    private static string? TrimOpis(string? opis, int max)
    {
        if (string.IsNullOrWhiteSpace(opis)) return null;
        var o = opis.Trim();
        if (o.Length <= max) return o;
        return o[..max].TrimEnd() + "...";
    }
}
