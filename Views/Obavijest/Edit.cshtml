@model planinarenje.Entiteti.Obavijest

@{
    ViewData["Title"] = "Uredi obavijest";
}

@section Breadcrumbs {
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb mb-0">
            <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Naslovnica</a></li>
            <li class="breadcrumb-item"><a asp-controller="Obavijest" asp-action="Index">Obavijesti</a></li>
            <li class="breadcrumb-item active" aria-current="page">Uredi obavijest</li>
        </ol>
    </nav>
}

<section class="detail-panel">
    <h1 class="section-title no-accent mb-4">Uredi obavijest</h1>

    <form asp-action="Edit" method="post" class="app-card">
        <input type="hidden" asp-for="IdObavijest" />
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

        <div class="mb-3">
            <label asp-for="Naslov" class="form-label"></label>
            <input asp-for="Naslov" class="form-control" />
            <span asp-validation-for="Naslov" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Sadrzaj" class="form-label"></label>
            <textarea asp-for="Sadrzaj" class="form-control" rows="4"></textarea>
            <span asp-validation-for="Sadrzaj" class="text-danger"></span>
        </div>

        <div class="mb-3">
            @await Html.PartialAsync("_DateTimePicker", null, new ViewDataDictionary(ViewData)
            {
                { "FieldName", "DatumObjave" },
                { "Label", "Datum i vrijeme objave" },
                { "Value", Model?.DatumObjave.ToString("o") },
                { "IncludeTime", true },
                { "Required", true }
            })
        </div>

        @if ((bool)(ViewData["IsAdmin"] ?? false))
        {
            <div class="mb-3">
                <label asp-for="IdKorisnik" class="form-label">Autor</label>
                @await Html.PartialAsync("_AutocompleteDropdown", null, new ViewDataDictionary(ViewData)
                {
                    { "FieldName", "IdKorisnik" },
                    { "DisplayName", "Autor" },
                    { "SearchUrl", Url.Action("AutocompleteSearch", "Korisnik") },
                    { "CurrentId", Model?.IdKorisnik.ToString() },
                    { "CurrentText", ViewData["KorisnikText"]?.ToString() },
                    { "Placeholder", "Pretrazi korisnike..." },
                    { "IsRequired", true }
                })
            </div>
        }
        else
        {
            <input type="hidden" asp-for="IdKorisnik" />
        }

        <div class="form-check mb-4">
            <input asp-for="JeAktivna" class="form-check-input" />
            <label asp-for="JeAktivna" class="form-check-label"></label>
        </div>

        <div class="d-flex gap-2">
            <button type="submit" class="btn btn-primary">Spremi promjene</button>
            <a asp-controller="Obavijest" asp-action="Index" class="btn btn-outline-secondary">Odustani</a>
        </div>
    </form>
</section>
