@model planinarenje.Entiteti.Obavijest

@{
    ViewData["Title"] = "Obrisi obavijest";
}

@section Breadcrumbs {
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb mb-0">
            <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Naslovnica</a></li>
            <li class="breadcrumb-item"><a asp-controller="Obavijest" asp-action="Index">Obavijesti</a></li>
            <li class="breadcrumb-item active" aria-current="page">Obrisi obavijest</li>
        </ol>
    </nav>
}

<section class="mb-4">
    <h1 class="section-title mb-2">Obrisi obavijest</h1>
</section>

<div class="app-card">
    <div class="text-center py-4">
        <div class="delete-warning-icon">⚠️</div>
        <h4 class="mt-3 mb-1">Brisanje zapisa</h4>
        <p class="text-muted">Jesi li siguran da zelis obrisati <strong>@Model.Naslov</strong>?</p>
        <p class="text-muted small">Ova akcija se ne moze ponistiti.</p>

        <form asp-action="Delete" method="post" class="mt-4 d-flex justify-content-center gap-3">
            <input type="hidden" asp-for="IdObavijest" />
            @Html.AntiForgeryToken()
            <button type="submit" class="btn btn-danger btn-delete-confirm px-4">Potvrdi brisanje</button>
            <a asp-action="Index" class="btn btn-outline-secondary px-4">Odustani</a>
        </form>
    </div>
</div>
