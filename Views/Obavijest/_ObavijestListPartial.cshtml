@model IEnumerable<planinarenje.Entiteti.Obavijest>
@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore
@using planinarenje.Data
@using planinarenje.Entiteti
@inject UserManager<AppUser> UserManager
@inject PlaninarstvoDbContext DbContext

@{
    var jeAdmin = User.IsInRole("Admin");
    int? ownKorisnikId = null;
    if (User.Identity?.IsAuthenticated == true)
    {
        var appUserId = UserManager.GetUserId(User);
        ownKorisnikId = await DbContext.Korisnici
            .Where(k => k.AppUserId == appUserId)
            .Select(k => (int?)k.IdKorisnik)
            .FirstOrDefaultAsync();
    }
}

@if (!Model.Any())
{
    <div class="app-card">
        <h2 class="h5 mb-2">Nema dostupnih obavijesti</h2>
        <p class="text-muted mb-0">Trenutno nisu pronađene obavijesti za prikaz.</p>
    </div>
}
else
{
    <div class="app-card table-responsive p-0">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th class="ps-4">Naslov</th>
                    <th>Status</th>
                    <th>Datum objave</th>
                    <th>Autor</th>
                    <th class="text-end pe-4">Akcije</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var obavijest in Model)
                {
                    <tr data-id="@obavijest.IdObavijest">
                        <td class="ps-4 fw-medium">@obavijest.Naslov</td>
                        <td>
                            <span class="app-badge badge-subtle text-uppercase">
                                @(obavijest.JeAktivna ? "Aktivna" : "Neaktivna")
                            </span>
                        </td>
                        <td>@obavijest.DatumObjave.ToString("dd.MM.yyyy.")</td>
                        <td>
                            @(obavijest.Korisnik != null ? $"{obavijest.Korisnik.Ime} {obavijest.Korisnik.Prezime}" : "Nepoznato")
                        </td>
                        <td class="text-end pe-4">
                            <a asp-action="Details" asp-route-id="@obavijest.IdObavijest" class="btn btn-sm btn-outline-primary">Detalji</a>
                            @if (jeAdmin || (ownKorisnikId.HasValue && ownKorisnikId == obavijest.IdKorisnik))
                            {
                                <a asp-action="Edit" asp-route-id="@obavijest.IdObavijest" class="btn btn-sm btn-outline-secondary">Uredi</a>
                            }
                            @if (jeAdmin)
                            {
                                <a asp-action="Delete" asp-route-id="@obavijest.IdObavijest" class="btn btn-sm btn-outline-danger">Obrisi</a>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
