@model planinarenje.Models.ViewModels.PlaninarskaUdrugaEditModel

<section class="mb-4">
    <h1 class="section-title mb-2">Uredi udrugu</h1>
    <p class="text-muted mb-0">Azurirajte podatke o udruzi.</p>
</section>

<div class="app-card">
    <form asp-action="Edit" method="post">
        <div class="row">
            <div class="col-md-6 mb-3">
                <label asp-for="Naziv" class="form-label"></label>
                <input asp-for="Naziv" class="form-control" />
                <span asp-validation-for="Naziv" class="text-danger small"></span>
            </div>
            <div class="col-md-6 mb-3">
                <label asp-for="OIB" class="form-label"></label>
                <input asp-for="OIB" class="form-control" />
                <span asp-validation-for="OIB" class="text-danger small"></span>
            </div>
        </div>
        <div class="row">
            <div class="col-md-6 mb-3">
                <label asp-for="Email" class="form-label"></label>
                <input asp-for="Email" class="form-control" />
                <span asp-validation-for="Email" class="text-danger small"></span>
            </div>
            <div class="col-md-6 mb-3">
                <label asp-for="BrojTelefona" class="form-label"></label>
                <input asp-for="BrojTelefona" class="form-control" />
                <span asp-validation-for="BrojTelefona" class="text-danger small"></span>
            </div>
        </div>
        <div class="mb-3">
            <label asp-for="Adresa" class="form-label"></label>
            <input asp-for="Adresa" class="form-control" />
            <span asp-validation-for="Adresa" class="text-danger small"></span>
        </div>
        <div class="row">
            <div class="col-md-4 mb-3">
                <label asp-for="PostanskiBroj" class="form-label"></label>
                <input asp-for="PostanskiBroj" class="form-control" />
                <span asp-validation-for="PostanskiBroj" class="text-danger small"></span>
            </div>
            <div class="col-md-4 mb-3">
                <label asp-for="Grad" class="form-label"></label>
                <input asp-for="Grad" class="form-control" />
                <span asp-validation-for="Grad" class="text-danger small"></span>
            </div>
            <div class="col-md-4 mb-3">
                <label asp-for="Zupanija" class="form-label"></label>
                <input asp-for="Zupanija" class="form-control" />
                <span asp-validation-for="Zupanija" class="text-danger small"></span>
            </div>
        </div>
        <div class="mb-3">
            <label asp-for="BrojClanova" class="form-label"></label>
            <input asp-for="BrojClanova" class="form-control" />
            <span asp-validation-for="BrojClanova" class="text-danger small"></span>
        </div>
        <div class="d-flex gap-2">
            <button type="submit" class="btn btn-primary">Spremi</button>
            <a asp-action="Index" class="btn btn-outline-secondary">Odustani</a>
        </div>
    </form>
</div>
