@model IEnumerable<planinarenje.Models.PlaninarskaUdrugaIndexViewModel>
@{
    ViewData["Title"] = "Planinarske udruge";
}

@section Breadcrumbs {
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb mb-0">
            <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Naslovnica</a></li>
            <li class="breadcrumb-item active" aria-current="page">Udruge</li>
        </ol>
    </nav>
}

<div class="row align-items-center mt-3 mb-4">
    <div class="col-md-6">
        <h1 class="h3 mb-0 text-primary-dark"><i class="bi bi-people-fill me-2 opacity-75"></i>Planinarske udruge</h1>
    </div>
</div>

<div class="app-card table-responsive p-0">
    <table class="table table-hover align-middle mb-0">
        <thead class="table-light">
            <tr>
                <th scope="col" class="ps-4">Naziv udruge</th>
                <th scope="col">OIB</th>
                <th scope="col">Sjedište (Grad i Županija)</th>
                <th scope="col" class="text-end">Broj članova</th>
                <th scope="col" class="text-end pe-4">Akcije</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td class="ps-4 fw-medium text-primary-dark">
                        <i class="bi bi-shield-shaded me-2 text-muted"></i>@item.Naziv
                    </td>
                    <td class="text-muted font-monospace small">@item.OIB</td>
                    <td>
                        <div class="d-flex flex-column">
                            <span>@(string.IsNullOrWhiteSpace(item.Grad) ? "N/A" : item.Grad)</span>
                            <small class="text-muted">@(string.IsNullOrWhiteSpace(item.Zupanija) ? "" : item.Zupanija)</small>
                        </div>
                    </td>
                    <td class="text-end">
                        @if (item.BrojClanova.HasValue)
                        {
                            <span class="badge bg-light text-dark border"><i class="bi bi-person-fill me-1"></i>@item.BrojClanova</span>
                        }
                        else
                        {
                            <span class="text-muted small">Nema podataka</span>
                        }
                    </td>
                    <td class="text-end pe-4">
                        <a asp-action="Details" asp-route-id="@item.IdPlaninarskaUdruga" class="btn btn-sm btn-outline-primary">Detalji udruge</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
    @if (!Model.Any())
    {
        <div class="p-5 text-center text-muted">
            <i class="bi bi-people d-block fs-1 mb-3 opacity-50"></i>
            Nisu pronađene planinarske udruge u sustavu.
        </div>
    }
</div>