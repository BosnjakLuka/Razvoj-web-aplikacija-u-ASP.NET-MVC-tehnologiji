@model planinarenje.Entiteti.PlaninarskaUdruga

<section class="mb-4">
    <h1 class="section-title mb-2">Obrisi udrugu</h1>
    <p class="text-muted mb-0">Jeste li sigurni da zelite obrisati udrugu "@Model.Naziv"?</p>
</section>

<div class="app-card">
    <form asp-action="Delete" method="post">
        <input type="hidden" asp-for="IdPlaninarskaUdruga" />
        <div class="d-flex gap-2">
            <button type="submit" class="btn btn-danger">Potvrdi</button>
            <a asp-action="Index" class="btn btn-outline-secondary">Odustani</a>
        </div>
    </form>
</div>
