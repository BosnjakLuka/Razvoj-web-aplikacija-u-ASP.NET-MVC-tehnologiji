@model planinarenje.Models.ViewModels.RutaCreateModel

<section class="mb-4">
    <h1 class="section-title mb-2">Nova ruta</h1>
    <p class="text-muted mb-0">Unesite podatke o planinarskoj ruti.</p>
</section>

<div class="app-card">
    <form asp-action="Create" method="post">
        <div class="mb-3">
            <label asp-for="Naziv" class="form-label"></label>
            <input asp-for="Naziv" class="form-control" />
            <span asp-validation-for="Naziv" class="text-danger small"></span>
        </div>
        <div class="mb-3">
            <label asp-for="IdKontrolnaTocka" class="form-label">Kontrolna tocka</label>
            <select asp-for="IdKontrolnaTocka" asp-items="ViewBag.KontrolneTocke" class="form-select">
                <option value="">-- Odaberite kontrolnu tocku --</option>
            </select>
            <span asp-validation-for="IdKontrolnaTocka" class="text-danger small"></span>
        </div>
        <div class="row">
            <div class="col-md-6 mb-3">
                <label asp-for="Pocetak" class="form-label"></label>
                <input asp-for="Pocetak" class="form-control" />
                <span asp-validation-for="Pocetak" class="text-danger small"></span>
            </div>
            <div class="col-md-6 mb-3">
                <label asp-for="Kraj" class="form-label"></label>
                <input asp-for="Kraj" class="form-control" />
                <span asp-validation-for="Kraj" class="text-danger small"></span>
            </div>
        </div>
        <div class="row">
            <div class="col-md-4 mb-3">
                <label asp-for="VrijemeHodaMin" class="form-label"></label>
                <input asp-for="VrijemeHodaMin" class="form-control" />
                <span asp-validation-for="VrijemeHodaMin" class="text-danger small"></span>
            </div>
            <div class="col-md-4 mb-3">
                <label asp-for="DuljinaKm" class="form-label"></label>
                <input asp-for="DuljinaKm" class="form-control" />
                <span asp-validation-for="DuljinaKm" class="text-danger small"></span>
            </div>
            <div class="col-md-4 mb-3">
                <label asp-for="VisinskaRazlikaM" class="form-label"></label>
                <input asp-for="VisinskaRazlikaM" class="form-control" />
                <span asp-validation-for="VisinskaRazlikaM" class="text-danger small"></span>
            </div>
        </div>
        <div class="mb-3">
            <label asp-for="TezinaRute" class="form-label"></label>
            <select asp-for="TezinaRute" asp-items="Html.GetEnumSelectList<planinarenje.Entiteti.TezinaRute>()" class="form-select"></select>
            <span asp-validation-for="TezinaRute" class="text-danger small"></span>
        </div>
        <div class="row">
            <div class="col-md-6 mb-3">
                <label asp-for="OznakaNaTerenu" class="form-label"></label>
                <input asp-for="OznakaNaTerenu" class="form-control" />
                <span asp-validation-for="OznakaNaTerenu" class="text-danger small"></span>
            </div>
            <div class="col-md-6 mb-3">
                <label asp-for="GodinaObnove" class="form-label"></label>
                <input asp-for="GodinaObnove" class="form-control" />
                <span asp-validation-for="GodinaObnove" class="text-danger small"></span>
            </div>
        </div>
        <div class="mb-3">
            <label asp-for="GPXPath" class="form-label"></label>
            <input asp-for="GPXPath" class="form-control" />
            <span asp-validation-for="GPXPath" class="text-danger small"></span>
        </div>
        <div class="mb-3">
            <label asp-for="Opis" class="form-label"></label>
            <textarea asp-for="Opis" class="form-control" rows="4"></textarea>
            <span asp-validation-for="Opis" class="text-danger small"></span>
        </div>
        <div class="mb-3">
            <label asp-for="Napomena" class="form-label"></label>
            <textarea asp-for="Napomena" class="form-control" rows="3"></textarea>
            <span asp-validation-for="Napomena" class="text-danger small"></span>
        </div>
        <div class="d-flex gap-2">
            <button type="submit" class="btn btn-primary">Spremi</button>
            <a asp-action="Index" class="btn btn-outline-secondary">Odustani</a>
        </div>
    </form>
</div>
