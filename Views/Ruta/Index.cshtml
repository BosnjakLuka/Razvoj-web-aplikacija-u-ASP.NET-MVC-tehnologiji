@model IReadOnlyList<planinarenje.Models.RutaIndexCardViewModel>

@section Breadcrumbs {
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb mb-0">
            <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Naslovnica</a></li>
            <li class="breadcrumb-item active" aria-current="page">Rute</li>
        </ol>
    </nav>
}

<section class="mb-4">
    <div class="d-flex flex-wrap justify-content-between align-items-start gap-3">
        <div>
            <h1 class="section-title mb-2">Planinarske rute</h1>
            <p class="text-muted mb-0">Katalog ruta s brzim pretrazivanjem i CRUD akcijama.</p>
        </div>
        <a asp-action="Create" class="btn btn-primary">Nova ruta</a>
    </div>
</section>

<div class="d-flex flex-wrap gap-2 mb-3">
    <a asp-controller="Ruta" asp-action="PoTezini" asp-route-tezina="Laka" class="btn btn-outline-primary btn-sm">Lake</a>
    <a asp-controller="Ruta" asp-action="PoTezini" asp-route-tezina="Srednja" class="btn btn-outline-primary btn-sm">Srednje</a>
    <a asp-controller="Ruta" asp-action="PoTezini" asp-route-tezina="Teska" class="btn btn-outline-primary btn-sm">Teske</a>
</div>

<div class="app-card mb-4">
    <input type="text" id="searchInput" class="form-control" placeholder="Pretrazi rute..." />
</div>

<div id="resultsContainer">
    @await Html.PartialAsync("_RutaListPartial", Model)
</div>

@section Scripts {
    <script>
        $(function () {
            $('#searchInput').on('input', function () {
                const term = $(this).val();
                $.ajax({
                    url: '@Url.Action("Search", "Ruta")',
                    data: { searchTerm: term },
                    success: function (html) {
                        $('#resultsContainer').fadeOut(150, function () {
                            $(this).html(html).fadeIn(200);
                        });
                    }
                });
            });
        });
    </script>
}