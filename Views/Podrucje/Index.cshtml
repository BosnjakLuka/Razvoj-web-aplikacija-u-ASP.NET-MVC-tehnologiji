@model IReadOnlyList<planinarenje.Models.PodrucjeIndexCardViewModel>

@section Breadcrumbs {
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb mb-0">
            <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Naslovnica</a></li>
            <li class="breadcrumb-item active" aria-current="page">Podrucja</li>
        </ol>
    </nav>
}

<section class="mb-4">
    <h1 class="section-title no-accent mb-3">Planinarska podrucja Hrvatske</h1>
    <p class="text-muted mb-0">
        Vizualni pregled svih podrucja obilaznice, s fokusom na broj kontrolnih tocaka i minimalne uvjete za obilazak.
    </p>
</section>

@if (!Model.Any())
{
    <div class="app-card">
        <h2 class="h5 mb-2">Nema dostupnih podrucja</h2>
        <p class="text-muted mb-0">Trenutno nisu pronadeni podaci za prikaz.</p>
    </div>
}
else
{
    <section class="row g-4">
        @foreach (var item in Model)
        {
            <article class="col-12 col-md-6 col-xl-4">
                <div class="app-card d-flex flex-column h-100">
                    <div class="d-flex justify-content-between align-items-start gap-2 mb-3">
                        <h2 class="h5 mb-0">@item.Naziv</h2>
                        <span class="app-badge badge-subtle">@item.Regija</span>
                    </div>

                    <div class="d-flex flex-wrap gap-2 mb-3">
                        <span class="app-badge badge-primary">Minimalno @item.MinimalanBrojKTZaObilazak KT</span>
                        <span class="app-badge badge-success">Ukupno @item.UkupanBrojKT KT</span>
                    </div>

                    @if (!string.IsNullOrWhiteSpace(item.OpisPreview))
                    {
                        <p class="text-muted mb-4">@item.OpisPreview</p>
                    }
                    else
                    {
                        <p class="text-muted mb-4">Opis podrucja trenutno nije dostupan.</p>
                    }

                    <div class="mt-auto d-grid">
                        <a asp-controller="Podrucje"
                           asp-action="Details"
                           asp-route-id="@item.IdPodrucje"
                           class="btn btn-primary">
                            Detalji podrucja
                        </a>
                    </div>
                </div>
            </article>
        }
    </section>
}
