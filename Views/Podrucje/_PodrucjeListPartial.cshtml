@model IReadOnlyList<planinarenje.Models.PodrucjeIndexCardViewModel>

@if (!Model.Any())
{
    <div class="app-card">
        <h2 class="h5 mb-2">Nema dostupnih područja</h2>
        <p class="text-muted mb-0">Trenutno nisu pronađeni podatci za prikaz.</p>
    </div>
}
else
{
    <div class="app-card">
        <div class="table-responsive">
            <table class="table align-middle mb-0">
                <thead>
                    <tr>
                        <th>Naziv</th>
                        <th>Regija</th>
                        <th>Min KT</th>
                        <th>Ukupno KT</th>
                        <th class="text-end">Akcije</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr data-id="@item.IdPodrucje">
                            <td>@item.Naziv</td>
                            <td>@item.Regija</td>
                            <td>@item.MinimalanBrojKTZaObilazak</td>
                            <td>@item.UkupanBrojKT</td>
                            <td class="text-end">
                                <a asp-action="Details" asp-route-id="@item.IdPodrucje" class="btn btn-sm btn-outline-primary">Detalji</a>
                                <a asp-action="Edit" asp-route-id="@item.IdPodrucje" class="btn btn-sm btn-outline-secondary">Uredi</a>
                                <a asp-action="Delete" asp-route-id="@item.IdPodrucje" class="btn btn-sm btn-outline-danger">Obrisi</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
