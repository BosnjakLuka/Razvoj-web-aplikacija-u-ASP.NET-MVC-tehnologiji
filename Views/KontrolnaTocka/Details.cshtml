@model planinarenje.Entiteti.KontrolnaTocka

@section Breadcrumbs {
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb mb-0">
            <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Naslovnica</a></li>
            <li class="breadcrumb-item"><a asp-controller="KontrolnaTocka" asp-action="Index">Kontrolne točke</a></li>
            <li class="breadcrumb-item active" aria-current="page">@Model.Naziv</li>
        </ol>
    </nav>
}

<section class="detail-panel">
    <h1 class="section-title no-accent mb-4">@Model.Naziv</h1>

    <div class="row g-3">
        <div class="col-md-6">
            <strong>Tip kontrolne točke</strong>
            <p class="mb-0 text-muted">@Model.TipKontrolneTocke</p>
        </div>
        <div class="col-md-6">
            <strong>Nadmorska visina</strong>
            <p class="mb-0 text-muted">@(Model.NadmorskaVisina.HasValue ? $"{Model.NadmorskaVisina.Value} m n/v" : "Nije navedeno")</p>
        </div>
        <div class="col-md-6">
            <strong>Područje</strong>
            <p class="mb-0 text-muted">@(Model.Područje?.Naziv ?? "Nije navedeno")</p>
        </div>
        <div class="col-md-6">
            <strong>GUID oznaka</strong>
            <p class="mb-0 text-muted font-monospace">@Model.GUIDOznaka</p>
        </div>
        <div class="col-12">
            <strong>Opis</strong>
            <p class="mb-0 text-muted">@(string.IsNullOrWhiteSpace(Model.Opis) ? "Opis nije dostupan." : Model.Opis)</p>
        </div>
    </div>

    <div class="mt-4">
        <a asp-controller="KontrolnaTocka" asp-action="Index" class="btn btn-primary">Natrag na popis</a>
    </div>
</section>
