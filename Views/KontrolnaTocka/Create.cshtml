@model planinarenje.Models.ViewModels.KontrolnaTockaCreateModel

<section class="mb-4">
    <h1 class="section-title mb-2">Nova kontrolna tocka</h1>
    <p class="text-muted mb-0">Unesite podatke o kontrolnoj tocki.</p>
</section>

<div class="app-card">
    <form asp-action="Create" method="post">
        <div class="mb-3">
            <label asp-for="Naziv" class="form-label"></label>
            <input asp-for="Naziv" class="form-control" />
            <span asp-validation-for="Naziv" class="text-danger small"></span>
        </div>
        <div class="mb-3">
            <label asp-for="GUIDOznaka" class="form-label"></label>
            <input asp-for="GUIDOznaka" class="form-control" />
            <span asp-validation-for="GUIDOznaka" class="text-danger small"></span>
        </div>
        <div class="mb-3">
            <label asp-for="IdPodrucje" class="form-label">Podrucje</label>
            <select asp-for="IdPodrucje" asp-items="ViewBag.Podrucja" class="form-select">
                <option value="">-- Odaberite podrucje --</option>
            </select>
            <span asp-validation-for="IdPodrucje" class="text-danger small"></span>
        </div>
        <div class="mb-3">
            <label asp-for="TipKontrolneTocke" class="form-label"></label>
            <select asp-for="TipKontrolneTocke" asp-items="Html.GetEnumSelectList<planinarenje.Entiteti.TipKontrolneTocke>()" class="form-select"></select>
            <span asp-validation-for="TipKontrolneTocke" class="text-danger small"></span>
        </div>
        <div class="mb-3">
            <label asp-for="NadmorskaVisina" class="form-label"></label>
            <input asp-for="NadmorskaVisina" class="form-control" />
            <span asp-validation-for="NadmorskaVisina" class="text-danger small"></span>
        </div>
        <div class="mb-3">
            <label asp-for="Koordinate" class="form-label"></label>
            <input asp-for="Koordinate" class="form-control" />
            <span asp-validation-for="Koordinate" class="text-danger small"></span>
        </div>
        <div class="mb-3">
            <label asp-for="Opis" class="form-label"></label>
            <textarea asp-for="Opis" class="form-control" rows="4"></textarea>
            <span asp-validation-for="Opis" class="text-danger small"></span>
        </div>
        <div class="mb-3">
            <label asp-for="OpisZiga" class="form-label"></label>
            <textarea asp-for="OpisZiga" class="form-control" rows="3"></textarea>
            <span asp-validation-for="OpisZiga" class="text-danger small"></span>
        </div>
        <div class="d-flex gap-2">
            <button type="submit" class="btn btn-primary">Spremi</button>
            <a asp-action="Index" class="btn btn-outline-secondary">Odustani</a>
        </div>
    </form>
</div>
