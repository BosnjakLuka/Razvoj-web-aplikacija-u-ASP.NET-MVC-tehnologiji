@model planinarenje.Models.ViewModels.MedaljaEditModel

<section class="mb-4">
    <h1 class="section-title mb-2">Uredi medalju</h1>
    <p class="text-muted mb-0">Azurirajte podatke medalje.</p>
</section>

<div class="app-card">
    <form asp-action="Edit" method="post">
        <div class="mb-3">
            <label asp-for="Naziv" class="form-label"></label>
            <input asp-for="Naziv" class="form-control" />
            <span asp-validation-for="Naziv" class="text-danger small"></span>
        </div>
        <div class="row">
            <div class="col-md-6 mb-3">
                <label asp-for="MinimalanBrojKontrolnihTocaka" class="form-label"></label>
                <input asp-for="MinimalanBrojKontrolnihTocaka" class="form-control" />
                <span asp-validation-for="MinimalanBrojKontrolnihTocaka" class="text-danger small"></span>
            </div>
            <div class="col-md-6 mb-3">
                <label asp-for="MinimalanBrojPodrucja" class="form-label"></label>
                <input asp-for="MinimalanBrojPodrucja" class="form-control" />
                <span asp-validation-for="MinimalanBrojPodrucja" class="text-danger small"></span>
            </div>
        </div>
        <div class="mb-3">
            <label asp-for="Opis" class="form-label"></label>
            <textarea asp-for="Opis" class="form-control" rows="4"></textarea>
            <span asp-validation-for="Opis" class="text-danger small"></span>
        </div>
        <div class="d-flex gap-2">
            <button type="submit" class="btn btn-primary">Spremi</button>
            <a asp-action="Index" class="btn btn-outline-secondary">Odustani</a>
        </div>
    </form>
</div>
