@model IReadOnlyList<planinarenje.Models.MedaljaIndexCardViewModel>

@if (!Model.Any())
{
    <div class="app-card">
        <h2 class="h5 mb-2">Nema dostupnih medalja</h2>
        <p class="text-muted mb-0">Trenutno nisu pronadeni podaci za prikaz priznanja.</p>
    </div>
}
else
{
    <div class="app-card table-responsive p-0">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th class="ps-4">Naziv</th>
                    <th>Min KT</th>
                    <th>Min podrucja</th>
                    <th class="text-end pe-4">Akcije</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var medalja in Model)
                {
                    <tr data-id="@medalja.IdMedalja">
                        <td class="ps-4">@medalja.Naziv</td>
                        <td>@medalja.MinimalanBrojKontrolnihTocaka</td>
                        <td>@medalja.MinimalanBrojPodrucja</td>
                        <td class="text-end pe-4">
                            <a asp-action="Details" asp-route-id="@medalja.IdMedalja" class="btn btn-sm btn-outline-primary">Detalji</a>
                            <a asp-action="Edit" asp-route-id="@medalja.IdMedalja" class="btn btn-sm btn-outline-secondary">Uredi</a>
                            <a asp-action="Delete" asp-route-id="@medalja.IdMedalja" class="btn btn-sm btn-outline-danger">Obrisi</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
