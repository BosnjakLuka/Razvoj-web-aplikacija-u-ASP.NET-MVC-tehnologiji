@using Microsoft.AspNetCore.Identity
@using planinarenje.Entiteti
@inject SignInManager<AppUser> SignInManager

<nav class="navbar navbar-expand-lg subnav">
    <div class="container">
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#subnavCollapse"
                aria-controls="subnavCollapse" aria-expanded="false" aria-label="Otvori izbornik">
            <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="subnavCollapse">
            <ul class="navbar-nav flex-wrap">
                <li class="nav-item text-nowrap"><a class="nav-link" asp-controller="KontrolnaTocka" asp-action="Index">Kontrolne točke</a></li>
                <li class="nav-item text-nowrap"><a class="nav-link" asp-controller="Ruta" asp-action="Index">Rute</a></li>
                <li class="nav-item text-nowrap"><a class="nav-link" asp-controller="Podrucje" asp-action="Index">Područja</a></li>
                <li class="nav-item text-nowrap"><a class="nav-link" asp-controller="PlaninarskiObjekt" asp-action="Index">Objekti</a></li>
                <li class="nav-item text-nowrap"><a class="nav-link" asp-controller="PlaninarskaUdruga" asp-action="Index">Udruge</a></li>
                @if (SignInManager.IsSignedIn(User))
                {
                    <li class="nav-item text-nowrap"><a class="nav-link" asp-controller="Korisnik" asp-action="Index">Korisnici</a></li>
                    <li class="nav-item text-nowrap"><a class="nav-link" asp-controller="Knjizica" asp-action="Index">E-Knjizica</a></li>
                    <li class="nav-item text-nowrap"><a class="nav-link" asp-controller="Posjet" asp-action="Index">Posjeti</a></li>
                }
                <li class="nav-item text-nowrap"><a class="nav-link" asp-controller="Obavijest" asp-action="Index">Obavijesti</a></li>
                @if (User.IsInRole("Admin"))
                {
                    <li class="nav-item text-nowrap"><a class="nav-link" asp-controller="Fotografija" asp-action="Index">Fotografije</a></li>
                }
                <li class="nav-item text-nowrap"><a class="nav-link" asp-controller="KorisnikMedalja" asp-action="Index">Dodijeljene medalje</a></li>
                <li class="nav-item text-nowrap"><a class="nav-link" asp-controller="Medalja" asp-action="Index">Priznanja i medalje</a></li>
            </ul>
        </div>
    </div>
</nav>
