<!DOCTYPE html>
<html lang="hr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Planinarska Knjižica</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/planinarenje.styles.css" asp-append-version="true" />
        <link rel="stylesheet"
            href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css" />
    <!-- Globalna tipografija -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
</head>
<body class="app-shell">
    @{ 
        var hasPosjetSuccess = TempData["PosjetSuccess"] != null;
    var hasMedaljaSuccess = TempData["MedaljaSuccess"] != null;
        var successMessage = TempData["Success"]?.ToString();
        var errorMessage = TempData["Error"]?.ToString();
            var warningMessage = ViewData["PopupWarning"]?.ToString();
    }
    <header>
        <nav class="navbar navbar-expand-lg topbar">
            <div class="container">
                <a class="brand-mark" asp-area="" asp-controller="Home" asp-action="Index">
                    <!-- Hiking ikona placeholder -->
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="currentColor" class="bi bi-geo-alt-fill" viewBox="0 0 16 16">
                        <path d="M8 16s6-5.686 6-10A6 6 0 0 0 2 6c0 4.314 6 10 6 10m0-7a3 3 0 1 1 0-6 3 3 0 0 1 0 6"/>
                    </svg>
                    <span>Planinarska Knjižica</span>
                </a>
                <button class="navbar-toggler outline-none" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation" style="border-color: rgba(255,255,255,0.3);">
                    <span class="navbar-toggler-icon" style="filter: invert(1);"></span>
                </button>
                <div class="navbar-collapse collapse d-lg-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1 ms-4 main-nav flex-wrap">
                        <li class="nav-item text-nowrap"><a class="nav-link" asp-controller="Home" asp-action="Index">Naslovnica</a></li>
                        <li class="nav-item text-nowrap"><a class="nav-link" asp-controller="KontrolnaTocka" asp-action="Index">Kontrolne točke</a></li>
                        <li class="nav-item text-nowrap"><a class="nav-link" asp-controller="Ruta" asp-action="Index">Rute</a></li>
                        <li class="nav-item text-nowrap"><a class="nav-link" asp-controller="Podrucje" asp-action="Index">Područja</a></li>
                        <li class="nav-item text-nowrap"><a class="nav-link" asp-controller="PlaninarskiObjekt" asp-action="Index">Objekti</a></li>
                        <li class="nav-item text-nowrap"><a class="nav-link" asp-controller="PlaninarskaUdruga" asp-action="Index">Udruge</a></li>
                        <li class="nav-item text-nowrap"><a class="nav-link" asp-controller="Korisnik" asp-action="Index">Korisnici</a></li>
                        <li class="nav-item text-nowrap"><a class="nav-link" asp-controller="Knjizica" asp-action="Index">E-Knjizica</a></li>
                        <li class="nav-item text-nowrap"><a class="nav-link" asp-controller="Posjet" asp-action="Index">Posjeti</a></li>
                        <li class="nav-item text-nowrap"><a class="nav-link" asp-controller="Obavijest" asp-action="Index">Obavijesti</a></li>
                        <li class="nav-item text-nowrap"><a class="nav-link" asp-controller="Fotografija" asp-action="Index">Fotografije</a></li>
                        <li class="nav-item text-nowrap"><a class="nav-link" asp-controller="KorisnikMedalja" asp-action="Index">Dodijeljene medalje</a></li>
                        <li class="nav-item text-nowrap"><a class="nav-link" asp-controller="Medalja" asp-action="Index">Sve medalje</a></li>
                    </ul>
                    <partial name="_LoginPartial" />
                </div>
            </div>
        </nav>
    </header>

    <!-- Meta-red / Breadcrumbs Placeholder -->
    @if (ViewData["Title"]?.ToString() != "Naslovnica")
    {
        <div class="breadcrumb-wrap">
            <div class="container">
                @if (IsSectionDefined("Breadcrumbs"))
                {
                    @RenderSection("Breadcrumbs", required: false)
                }
                else
                {
                    <nav aria-label="breadcrumb">
                        <ol class="breadcrumb mb-0">
                            <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Naslovnica</a></li>
                            <li class="breadcrumb-item active" aria-current="page">@ViewData["Title"]</li>
                        </ol>
                    </nav>
                }
            </div>
        </div>
    }

    <!-- Main Content Wrapper -->
    @if (ViewData["Title"]?.ToString() == "Naslovnica")
    {
        <main role="main" class="flex-grow-1">
            @if (!string.IsNullOrWhiteSpace(successMessage) && !hasPosjetSuccess && !hasMedaljaSuccess)
            {
                <script>
                    document.addEventListener('DOMContentLoaded', function () {
                        showToast('@Html.Raw(successMessage)', 'success');
                    });
                </script>
            }
            @if (!string.IsNullOrWhiteSpace(successMessage) && hasPosjetSuccess)
            {
                <script>
                    document.addEventListener('DOMContentLoaded', function () {
                        setTimeout(function () {
                            showToast('@Html.Raw(successMessage)', 'success');
                        }, 5000);
                    });
                </script>
            }
            @if (!string.IsNullOrWhiteSpace(successMessage) && hasMedaljaSuccess)
            {
                <script>
                    document.addEventListener('DOMContentLoaded', function () {
                        setTimeout(function () {
                            showToast('@Html.Raw(successMessage)', 'success');
                        }, 5500);
                    });
                </script>
            }
            @if (!string.IsNullOrWhiteSpace(errorMessage))
            {
                <script>
                    document.addEventListener('DOMContentLoaded', function () {
                        showToast('@Html.Raw(errorMessage)', 'error');
                    });
                </script>
            }
            @if (!string.IsNullOrWhiteSpace(warningMessage))
            {
                <script>
                    document.addEventListener('DOMContentLoaded', function () {
                        showToast('@Html.Raw(warningMessage)', 'warning');
                    });
                </script>
            }
            @RenderBody()
        </main>
    }
    else
    {
        <div class="container page-container">
            <main role="main">
                @if (!string.IsNullOrWhiteSpace(successMessage) && !hasPosjetSuccess && !hasMedaljaSuccess)
                {
                    <script>
                        document.addEventListener('DOMContentLoaded', function () {
                            showToast('@Html.Raw(successMessage)', 'success');
                        });
                    </script>
                }
                @if (!string.IsNullOrWhiteSpace(successMessage) && hasPosjetSuccess)
                {
                    <script>
                        document.addEventListener('DOMContentLoaded', function () {
                            setTimeout(function () {
                                showToast('@Html.Raw(successMessage)', 'success');
                            }, 5000);
                        });
                    </script>
                }
                    @if (!string.IsNullOrWhiteSpace(successMessage) && hasMedaljaSuccess)
                    {
                        <script>
                            document.addEventListener('DOMContentLoaded', function () {
                                setTimeout(function () {
                                    showToast('@Html.Raw(successMessage)', 'success');
                                }, 5500);
                            });
                        </script>
                    }
                @if (!string.IsNullOrWhiteSpace(errorMessage))
                {
                    <script>
                        document.addEventListener('DOMContentLoaded', function () {
                            showToast('@Html.Raw(errorMessage)', 'error');
                        });
                    </script>
                }
                @if (!string.IsNullOrWhiteSpace(warningMessage))
                {
                    <script>
                        document.addEventListener('DOMContentLoaded', function () {
                            showToast('@Html.Raw(warningMessage)', 'warning');
                        });
                    </script>
                }
                @RenderBody()
            </main>
        </div>
    }

    @if (hasPosjetSuccess)
    {
        @await Html.PartialAsync("_SummitAnimation")
    }

    @if (hasMedaljaSuccess)
    {
        @await Html.PartialAsync("_MedalAnimation")
    }

    <footer class="footer-shell">
        <div class="container text-center">
            <p class="mb-1"><strong>Osobna digitalna planinarska evidencija</strong></p>
            <p class="small mb-0 opacity-75">&copy; 2026 - Razvoj web aplikacija</p>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>
    <script src="https://cdn.jsdelivr.net/npm/flatpickr/dist/l10n/hr.js"></script>
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/autocomplete.js" asp-append-version="true"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)

    <div id="toast-container"
            style="position:fixed; inset:0; pointer-events:none; z-index:9999; display:flex; align-items:center; justify-content:center;">
    </div>
</body>
</html>
