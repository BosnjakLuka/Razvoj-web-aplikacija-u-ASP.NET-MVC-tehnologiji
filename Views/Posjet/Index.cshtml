@model IReadOnlyList<planinarenje.Models.PosjetIndexViewModel>

@section Breadcrumbs {
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb mb-0">
            <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Naslovnica</a></li>
            <li class="breadcrumb-item active" aria-current="page">Posjeti</li>
        </ol>
    </nav>
}

<section class="mb-4">
    <div class="d-flex flex-wrap justify-content-between align-items-start gap-3">
        <div>
            <h1 class="section-title no-accent mb-2">Evidencija posjeta</h1>
            <p class="text-muted mb-0">Prikaz svih ostvarenih planinarskih aktivnosti.</p>
        </div>
        <a asp-action="Create" class="btn btn-primary">Novi posjet</a>
    </div>
</section>

<div class="app-card mb-4">
    <input type="text" id="searchInput" class="form-control" placeholder="Pretrazi posjete..." />
</div>

<div id="resultsContainer">
    @await Html.PartialAsync("_PosjetListPartial", Model)
</div>

@section Scripts {
    <script>
        $(function () {
            $('#searchInput').on('input', function () {
                const term = $(this).val();
                $.ajax({
                    url: '@Url.Action("Search", "Posjet")',
                    data: { searchTerm: term },
                    success: function (html) {
                        $('#resultsContainer').fadeOut(150, function () {
                            $(this).html(html).fadeIn(200);
                        });
                    }
                });
            });
        });
    </script>
}