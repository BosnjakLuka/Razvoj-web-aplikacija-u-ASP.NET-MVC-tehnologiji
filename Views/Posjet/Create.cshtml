@model planinarenje.Models.ViewModels.PosjetCreateModel
@inject planinarenje.Services.IAiUnosService AiUnos

<section class="mb-4">
    <h1 class="section-title mb-2">Novi posjet</h1>
    <p class="text-muted mb-0">Unesite podatke o posjetu kontrolnoj tocki.</p>
</section>

@if (AiUnos.JeDostupan)
{
    <div class="app-card mb-3 ai-asistent-card">
        <h2 class="h6 text-uppercase fw-bold mb-2">AI asistent za brzi unos</h2>
        <p class="text-muted small mb-2">
            Opišite posjet prirodnim jezikom pa ćemo automatski popuniti formu ispod.
            GUID oznaku sa žiga ipak upišite ručno radi potvrde obilaska.
        </p>
        <p class="text-muted small mb-2">
            Najbolji redoslijed: <strong>1)</strong> naziv kontrolne točke, <strong>2)</strong> naziv
            rute, <strong>3)</strong> datum i vrijeme (ili npr. "jučer u 11 sati", "prošlu subotu ujutro"),
            <strong>4)</strong> opis, trajanje uspona i kakav je dojam bio.
        </p>
        <p class="small mb-2 ai-primjer">
            Primjer: <em>"Bio sam na Sljemenu, rutom Gračani – Puntijarka – Sljeme, prošlu subotu
            u 9 sati ujutro. Uspon je trajao oko 2 i pol sata, bilo je fizički naporno."</em>
        </p>
        <textarea id="aiUpit" class="form-control mb-2" rows="3"
                  placeholder="Opišite svoj posjet..."></textarea>
        <div class="d-flex align-items-center gap-2">
            <button type="button" id="aiPopuni" class="btn btn-outline-success btn-sm">
                <span class="ai-spinner spinner-border spinner-border-sm d-none" role="status" aria-hidden="true"></span>
                Popuni formu
            </button>
            <span id="aiStatus" class="small text-muted"></span>
        </div>
    </div>
}

<div class="app-card">
    <form asp-action="Create" method="post">
        <div class="row">
            <div class="col-md-6 mb-3">
                <label asp-for="IdKorisnik" class="form-label">Korisnik</label>
                @await Html.PartialAsync("_AutocompleteDropdown", null, new ViewDataDictionary(ViewData)
                {
                    { "FieldName", "IdKorisnik" },
                    { "DisplayName", "Korisnik" },
                    { "SearchUrl", Url.Action("AutocompleteSearch", "Korisnik") },
                    { "CurrentId", Model?.IdKorisnik.ToString() },
                    { "CurrentText", ViewData["KorisnikText"]?.ToString() },
                    { "Placeholder", "Pretrazi korisnike..." },
                    { "IsRequired", true }
                })
            </div>
            <div class="col-md-6 mb-3">
                <label asp-for="IdKnjizica" class="form-label">Knjizica</label>
                @await Html.PartialAsync("_AutocompleteDropdown", null, new ViewDataDictionary(ViewData)
                {
                    { "FieldName", "IdKnjizica" },
                    { "DisplayName", "Knjizica" },
                    { "SearchUrl", Url.Action("AutocompleteSearch", "Knjizica") },
                    { "CurrentId", Model?.IdKnjizica.ToString() },
                    { "CurrentText", ViewData["KnjizicaText"]?.ToString() },
                    { "Placeholder", "Pretrazi knjizice..." },
                    { "IsRequired", true }
                })
            </div>
        </div>
        <div class="row">
            <div class="col-md-6 mb-3">
                <label asp-for="IdKontrolnaTocka" class="form-label">Kontrolna tocka</label>
                @await Html.PartialAsync("_AutocompleteDropdown", null, new ViewDataDictionary(ViewData)
                {
                    { "FieldName", "IdKontrolnaTocka" },
                    { "DisplayName", "Kontrolna tocka" },
                    { "SearchUrl", Url.Action("AutocompleteSearch", "KontrolnaTocka") },
                    { "CurrentId", Model?.IdKontrolnaTocka.ToString() },
                    { "CurrentText", ViewData["KontrolnaTockaText"]?.ToString() },
                    { "Placeholder", "Pretrazi kontrolne tocke..." },
                    { "IsRequired", true }
                })
            </div>
            <div class="col-md-6 mb-3">
                <label asp-for="IdRuta" class="form-label">Ruta</label>
                <select asp-for="IdRuta" class="form-select" asp-items="ViewBag.RuteOptions">
                    <option value="">Odaberi kontrolnu tocku prvo</option>
                </select>
                <span asp-validation-for="IdRuta" class="text-danger small"></span>
            </div>
        </div>
        <div class="row">
            <div class="col-md-6 mb-3">
                @await Html.PartialAsync("_DateTimePicker", null, new ViewDataDictionary(ViewData)
                {
                    { "FieldName", "DatumVrijemePosjeta" },
                    { "Label", "Datum i vrijeme posjeta" },
                    { "IncludeTime", true },
                    { "Required", true }
                })
            </div>
            <div class="col-md-6 mb-3">
                <label asp-for="VrijemeUsponaMin" class="form-label"></label>
                <input asp-for="VrijemeUsponaMin" class="form-control" />
                <span asp-validation-for="VrijemeUsponaMin" class="text-danger small"></span>
            </div>
        </div>
        <div class="mb-3">
            <label asp-for="DozivljajPosjeta" class="form-label"></label>
            <select asp-for="DozivljajPosjeta" asp-items="Html.GetEnumSelectList<planinarenje.Entiteti.DozivljajPosjeta>()" class="form-select"></select>
            <span asp-validation-for="DozivljajPosjeta" class="text-danger small"></span>
        </div>
        <div class="mb-3">
            <label asp-for="UneseniGUID" class="form-label">GUID vrha</label>
            <input asp-for="UneseniGUID" class="form-control" placeholder="Rucno unesi GUID vrha" />
            <span asp-validation-for="UneseniGUID" class="text-danger small"></span>
        </div>
        <div class="mb-3">
            <label asp-for="OpisIskustva" class="form-label"></label>
            <textarea asp-for="OpisIskustva" class="form-control" rows="4"></textarea>
            <span asp-validation-for="OpisIskustva" class="text-danger small"></span>
        </div>
        <div class="d-flex gap-2">
            <button type="submit" class="btn btn-primary">Spremi</button>
            <a asp-action="Index" class="btn btn-outline-secondary">Odustani</a>
        </div>
    </form>
</div>

@section Scripts {
    <script>
        $(function () {
            const mapData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(ViewBag.KnjiziceByKorisnik ?? new List<object>()));
            const korisnikToKnjizica = new Map(mapData.map(x => [String(x.IdKorisnik), { id: String(x.IdKnjizica), label: x.Label }]));
            const korisnikHidden = $('#hidden_IdKorisnik');
            const knjizicaHidden = $('#hidden_IdKnjizica');
            const knjizicaDisplay = $('#display_IdKnjizica');
            const routeUrl = '@Url.Action("RuteZaKontrolnuTocku", "Posjet")';
            const kontrolnaHidden = document.getElementById('hidden_IdKontrolnaTocka');
            const routeSelect = document.getElementById('IdRuta');

            function resetRoutes() {
                if (!routeSelect) return;
                routeSelect.innerHTML = '<option value="">Odaberi kontrolnu tocku prvo</option>';
                routeSelect.value = '';
            }

            function loadRoutes(kontrolnaTockaId, selectedRutaId) {
                if (!routeSelect) return;

                if (!kontrolnaTockaId) {
                    resetRoutes();
                    return;
                }

                $.ajax({
                    url: routeUrl,
                    data: { kontrolnaTockaId: kontrolnaTockaId },
                    success: function (results) {
                        routeSelect.innerHTML = '<option value="">Odaberi rutu</option>';
                        (results || []).forEach(function (item) {
                            const option = document.createElement('option');
                            option.value = item.value;
                            option.textContent = item.label;
                            if (selectedRutaId && String(selectedRutaId) === String(item.value)) {
                                option.selected = true;
                            }
                            routeSelect.appendChild(option);
                        });
                    },
                    error: function () {
                        resetRoutes();
                    }
                });
            }

            function applyKnjizica(korisnikId) {
                if (!korisnikId) {
                    knjizicaHidden.val('');
                    knjizicaDisplay.val('');
                    return;
                }

                const data = korisnikToKnjizica.get(String(korisnikId));
                if (!data) return;

                knjizicaHidden.val(data.id).trigger('change');
                knjizicaDisplay.val(data.label);
            }

            korisnikHidden.on('change', function () {
                applyKnjizica($(this).val());
            });

            if (kontrolnaHidden) {
                kontrolnaHidden.addEventListener('autocomplete:selected', function (e) {
                    const data = e.detail || {};
                    loadRoutes(data.value || '', '');
                });

                kontrolnaHidden.addEventListener('change', function () {
                    if (!kontrolnaHidden.value) {
                        resetRoutes();
                    }
                });
            }

            loadRoutes(kontrolnaHidden ? kontrolnaHidden.value : '', $('#IdRuta').val());
            applyKnjizica(korisnikHidden.val());

            // AI integracija: prirodni jezik -> prefill forme. AI je samo parser;
            // submit i dalje ide kroz standardni Create POST sa svom validacijom.
            const aiUrl = '@Url.Action("AiPrijedlog", "Posjet")';
            const aiBtn = $('#aiPopuni');

            function setAiStatus(text, vrsta) {
                const $s = $('#aiStatus').removeClass('text-muted text-danger text-success');
                $s.addClass(vrsta === 'greska' ? 'text-danger' : vrsta === 'ok' ? 'text-success' : 'text-muted');
                $s.text(text || '');
            }

            aiBtn.on('click', function () {
                const upit = ($('#aiUpit').val() || '').trim();
                if (!upit) {
                    setAiStatus('Upišite kratak opis posjeta.', 'greska');
                    return;
                }

                const token = $('input[name="__RequestVerificationToken"]').first().val();
                const $spinner = aiBtn.find('.ai-spinner');

                $spinner.removeClass('d-none');
                aiBtn.prop('disabled', true);
                setAiStatus('AI obrađuje upit...', 'info');

                $.ajax({
                    url: aiUrl,
                    method: 'POST',
                    data: { upit: upit, __RequestVerificationToken: token },
                    success: function (data) {
                        if (data.idKontrolnaTocka) {
                            $('#hidden_IdKontrolnaTocka').val(data.idKontrolnaTocka);
                            $('#display_IdKontrolnaTocka').val(data.kontrolnaTockaNaziv || '');
                            loadRoutes(data.idKontrolnaTocka, data.idRuta || '');
                        }
                        if (data.dozivljaj !== null && data.dozivljaj !== undefined) {
                            $('#DozivljajPosjeta').val(String(data.dozivljaj));
                        }
                        if (data.vrijemeUsponaMin !== null && data.vrijemeUsponaMin !== undefined) {
                            $('#VrijemeUsponaMin').val(data.vrijemeUsponaMin);
                        }
                        if (data.opisIskustva) {
                            $('#OpisIskustva').val(data.opisIskustva);
                        }
                        const dpInput = document.getElementById('dp_DatumVrijemePosjeta');
                        if (dpInput && dpInput._flatpickr && data.datum) {
                            dpInput._flatpickr.setDate(new Date(data.datum), true);
                        }

                        if (data.poruka) {
                            setAiStatus(data.poruka, 'greska');
                        } else {
                            setAiStatus('Forma je popunjena. Provjerite podatke i upišite GUID sa žiga.', 'ok');
                        }
                    },
                    error: function (xhr) {
                        let poruka = 'AI trenutno nije dostupan. Popunite formu ručno.';
                        if (xhr.responseJSON && xhr.responseJSON.poruka) {
                            poruka = xhr.responseJSON.poruka;
                        }
                        setAiStatus(poruka, 'greska');
                    },
                    complete: function () {
                        $spinner.addClass('d-none');
                        aiBtn.prop('disabled', false);
                    }
                });
            });
        });
    </script>
}
