@model planinarenje.Models.ViewModels.KnjizicaEligibilityPageViewModel

<section class="mb-4">
    <div class="d-flex flex-wrap justify-content-between align-items-start gap-3">
        <div>
            <h1 class="section-title mb-2">Nova knjizica</h1>
            <p class="text-muted mb-0">Odaberi korisnika koji još nema knjižicu i dodijeli mu je jednim klikom.</p>
        </div>
        <a asp-action="Index" class="btn btn-outline-secondary">Natrag na popis</a>
    </div>
</section>

<div class="app-card">
    @if (Model.EligibleUsers.Count == 0)
    {
        <div class="alert alert-light mb-0">
            Trenutno nema korisnika kojima se može dodijeliti knjižica - svi aktivni korisnici već imaju knjižicu.
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Korisnik</th>
                        <th class="text-end">Akcija</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var user in Model.EligibleUsers)
                    {
                        <tr>
                            <td>
                                <div class="fw-semibold">@user.ImePrezimeKorisnika</div>
                                <div class="text-muted small">@user.KorisnickoIme</div>
                            </td>
                            <td class="text-end">
                                <form asp-action="Dodijeli" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="korisnikId" value="@user.IdKorisnik" />
                                    <button type="submit" class="btn btn-success btn-sm">Dodijeli</button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
