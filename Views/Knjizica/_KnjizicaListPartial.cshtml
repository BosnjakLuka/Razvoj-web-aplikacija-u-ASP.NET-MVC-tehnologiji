@model List<planinarenje.Models.KnjizicaIndexViewModel>

@if (!Model.Any())
{
    <div class="app-card">
        <h2 class="h5 mb-2">Nema evidentiranih knjizica</h2>
        <p class="text-muted mb-0">Trenutno nisu pronađeni podatci za prikaz.</p>
    </div>
}
else
{
    <div class="app-card table-responsive p-0">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th class="ps-4">ID</th>
                    <th>Vlasnik</th>
                    <th>Datum otvaranja</th>
                    <th>Status</th>
                    <th class="text-end pe-4">Akcije</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var knjizica in Model)
                {
                    <tr>
                        <td class="ps-4 font-monospace text-muted">#@knjizica.IdKnjizica</td>
                        <td>@knjizica.ImePrezimeKorisnika</td>
                        <td>@knjizica.DatumKreiranja.ToString("dd.MM.yyyy. HH:mm")</td>
                        <td>
                            @if (knjizica.StatusAktivna)
                            {
                                <span class="badge bg-success-subtle text-success">Aktivna</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary-subtle text-secondary">Zatvorena</span>
                            }
                        </td>
                        <td class="text-end pe-4">
                            <a asp-action="Details" asp-route-id="@knjizica.IdKnjizica" class="btn btn-sm btn-outline-primary">Detalji</a>
                            <a asp-action="Edit" asp-route-id="@knjizica.IdKnjizica" class="btn btn-sm btn-outline-secondary">Uredi</a>
                            <a asp-action="Delete" asp-route-id="@knjizica.IdKnjizica" class="btn btn-sm btn-outline-danger">Obrisi</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
