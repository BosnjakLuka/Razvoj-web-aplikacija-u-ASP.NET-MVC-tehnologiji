@model List<planinarenje.Models.KnjizicaIndexViewModel>
@{
    ViewData["Title"] = "Planinarske Knjižice";
}

@section Breadcrumbs {
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb mb-0">
            <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Naslovnica</a></li>
            <li class="breadcrumb-item active" aria-current="page">Planinarske knjižice</li>
        </ol>
    </nav>
}

<div class="row align-items-center mt-3 mb-4">
    <div class="col-md-8">
        <h1 class="h3 mb-1 text-primary-dark">Planinarske knjižice</h1>
        <p class="text-muted mb-0">Popis svih evidencijskih knjižica planinara i njihov trenutni status.</p>
    </div>
</div>

<div class="app-card shadow-sm border-0 mb-4 overflow-hidden">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th scope="col" class="ps-4">ID evidencije</th>
                    <th scope="col">Vlasnik knjižice</th>
                    <th scope="col">Datum otvaranja</th>
                    <th scope="col">Status</th>
                    <th scope="col" class="text-end pe-4">Akcije</th>
                </tr>
            </thead>
            <tbody class="border-top-0">
                @foreach (var knjizica in Model)
                {
                    <tr>
                        <td class="ps-4 font-monospace text-muted">#@knjizica.IdKnjizica</td>
                        <td>
                            <a asp-controller="Korisnik" asp-action="Details" asp-route-id="@knjizica.IdKorisnik" class="text-decoration-none fw-bold text-dark">
                                <i class="bi bi-person-badge text-primary opacity-75 me-2"></i>@knjizica.ImePrezimeKorisnika
                            </a>
                        </td>
                        <td>
                            <i class="bi bi-calendar-event opacity-50 me-2"></i>@knjizica.DatumKreiranja.ToString("dd.MM.yyyy. HH:mm")
                        </td>
                        <td>
                            @if (knjizica.StatusAktivna)
                            {
                                <span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-25 px-2 py-1">Aktivna</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary bg-opacity-10 text-secondary border border-secondary border-opacity-25 px-2 py-1">Završena / Zatvorena</span>
                            }
                        </td>
                        <td class="text-end pe-4">
                            <a asp-action="Details" asp-route-id="@knjizica.IdKnjizica" class="btn btn-sm btn-outline-primary shadow-sm rounded-pill">
                                Otvori knjižicu <i class="bi bi-chevron-right ms-1 small"></i>
                            </a>
                        </td>
                    </tr>
                }
                
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="5" class="text-center py-5 text-muted">
                            <i class="bi bi-journal-x fs-1 opacity-25 d-block mb-3"></i>
                            Nema evidentiranih planinarskih knjižica u sustavu.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
