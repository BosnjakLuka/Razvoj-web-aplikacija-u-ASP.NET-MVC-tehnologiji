@model planinarenje.Models.FotografijaDetailsViewModel
@{
    ViewData["Title"] = "Detalji fotografije";
}

@section Breadcrumbs {
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb mb-0">
            <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Naslovnica</a></li>
            <li class="breadcrumb-item"><a asp-controller="Fotografija" asp-action="Index">Fotografije</a></li>
            <li class="breadcrumb-item active" aria-current="page">@Model.NazivDatoteke</li>
        </ol>
    </nav>
}

<div class="mb-4 mt-3">
    <h1 class="h3 mb-0 text-primary-dark">Fotografija: @Model.NazivDatoteke</h1>
</div>

<div class="row g-4">
    <div class="col-lg-8">
        <div class="app-card h-auto text-center p-4 bg-light d-flex align-items-center justify-content-center" style="min-height: 400px;">
            @if (!string.IsNullOrEmpty(Model.PutanjaDatoteke) && !Model.PutanjaDatoteke.StartsWith("C:"))
            {
                <img src="@Model.PutanjaDatoteke" class="img-fluid rounded shadow-sm" style="max-height: 600px; width: auto;" alt="@Model.NazivDatoteke" />
            }
            else
            {
                <div class="foto-placeholder text-muted">
                    <i>Fotografija nije dostupna</i>
                    <p class="mb-0">@Model.NazivDatoteke</p>
                </div>
            }
        </div>
    </div>
    <div class="col-lg-4">
        <div class="app-card h-auto detail-panel p-4">
            <h4 class="h5 mb-4 text-primary-dark">Metapodaci</h4>
            <div class="mb-3">
                <span class="text-muted d-block small fw-bold">DATUM I VRIJEME UPLOADA</span>
                <p class="mb-0 fw-medium">@Model.DatumUploada.ToString("dd.MM.yyyy. u HH:mm") sati</p>
            </div>
            <div class="mb-3">
                <span class="text-muted d-block small fw-bold">TIP SLIKE</span>
                <span class="badge bg-secondary mt-1">@Model.TipSlike</span>
            </div>
            <div class="mb-3">
                <span class="text-muted d-block small fw-bold">POVEZANI POSJET</span>
                <p class="mb-0">
                    <a asp-controller="Posjet" asp-action="Details" asp-route-id="@Model.IdPosjet" class="fw-medium text-decoration-none">
                        <i class="bi bi-geo-alt me-1"></i>@Model.PosjetNaslov
                    </a>
                </p>
            </div>
            <hr class="my-4" />
            <div class="mb-4">
                <span class="text-muted d-block small fw-bold">OPIS</span>
                <p class="mb-0 mt-1">
                    @(string.IsNullOrWhiteSpace(Model.Opis) ? "Nema kreiranog opisa za ovu fotografiju." : Model.Opis)
                </p>
            </div>
            
            <div class="mt-4 pt-3 border-top">
                <a asp-action="Index" class="btn btn-outline-secondary w-100">Natrag na popis</a>
            </div>
        </div>
    </div>
</div>
