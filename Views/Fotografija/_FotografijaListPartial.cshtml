@model IEnumerable<planinarenje.Models.FotografijaIndexViewModel>

@if (!Model.Any())
{
    <div class="app-card">
        <h2 class="h5 mb-2">Nema dostupnih fotografija</h2>
        <p class="text-muted mb-0">Trenutno nisu pronađeni podatci za prikaz.</p>
    </div>
}
else
{
    <div class="app-card table-responsive p-0">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th class="ps-4">Naziv datoteke</th>
                    <th>Posjet</th>
                    <th>Datum uploada</th>
                    <th>Tip</th>
                    <th class="text-end pe-4">Akcije</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td class="ps-4 fw-medium">@item.NazivDatoteke</td>
                        <td>@item.PosjetNaslov</td>
                        <td>@item.DatumUploada.ToString("dd.MM.yyyy.")</td>
                        <td>@item.TipSlike</td>
                        <td class="text-end pe-4">
                            <a asp-action="Details" asp-route-id="@item.IdFotografija" class="btn btn-sm btn-outline-primary">Detalji</a>
                            <a asp-action="Edit" asp-route-id="@item.IdFotografija" class="btn btn-sm btn-outline-secondary">Uredi</a>
                            <a asp-action="Delete" asp-route-id="@item.IdFotografija" class="btn btn-sm btn-outline-danger">Obrisi</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
