@model IReadOnlyList<planinarenje.Models.KorisnikIndexCardViewModel>

@section Breadcrumbs {
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb mb-0">
            <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Naslovnica</a></li>
            <li class="breadcrumb-item active" aria-current="page">Korisnici</li>
        </ol>
    </nav>
}

<section class="mb-4">
    <div class="d-flex flex-wrap justify-content-between align-items-start gap-3">
        <div>
            <h1 class="section-title no-accent mb-2">Imenik korisnika</h1>
            <p class="text-muted mb-0">Prikaz svih registriranih korisnika aplikacije.</p>
        </div>
        <a asp-action="Create" class="btn btn-primary">Novi korisnik</a>
    </div>
</section>

<div class="app-card mb-4">
    <input type="text" id="searchInput" class="form-control" placeholder="Pretrazi korisnike..." />
</div>

<div id="searchSpinner" class="text-center py-2 d-none">
    <div class="spinner-border spinner-border-sm text-success" role="status"></div>
</div>

<div id="resultsContainer">
    @await Html.PartialAsync("_KorisnikListPartial", Model)
</div>

@section Scripts {
    <script>
        $(function () {
            $('#searchInput').on('input', function () {
                const term = $(this).val();
                $('#searchSpinner').removeClass('d-none');
                $.ajax({
                    url: '@Url.Action("Search", "Korisnik")',
                    data: { searchTerm: term },
                    success: function (html) {
                        $('#searchSpinner').addClass('d-none');
                        $('#resultsContainer').fadeOut(150, function () {
                            $(this).html(html).fadeIn(200);
                        });
                    },
                    error: function () {
                        $('#searchSpinner').addClass('d-none');
                        showToast('Greska pri pretrazi. Pokusaj ponovo.', 'error');
                    }
                });
            });
        });
    </script>

    @if (TempData["NewId"] != null)
    {
        <script>
            document.addEventListener('DOMContentLoaded', function () {
                const newId = @TempData["NewId"];
                const row = document.querySelector('tr[data-id="' + newId + '"]');
                if (row) {
                    row.style.transition = 'background 0.4s ease';
                    row.style.background = '#d1fae5';
                    setTimeout(function () {
                        row.style.background = '';
                    }, 2500);
                }
            });
        </script>
    }
}