@model IReadOnlyList<planinarenje.Models.KorisnikIndexCardViewModel>

@section Breadcrumbs {
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb mb-0">
            <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Naslovnica</a></li>
            <li class="breadcrumb-item active" aria-current="page">Korisnici</li>
        </ol>
    </nav>
}

<section class="mb-4">
    <h1 class="section-title no-accent mb-3">Imenik korisnika</h1>
    <p class="text-muted mb-0">
        Prikaz svih registriranih korisnika aplikacije.
    </p>
</section>

@if (!Model.Any())
{
    <div class="app-card">
        <h2 class="h5 mb-2">Nema registriranih korisnika</h2>
        <p class="text-muted mb-0">Trenutno nisu pronađeni podatci za prikaz.</p>
    </div>
}
else
{
    <div class="table-responsive app-card p-0">
        <table class="table table-hover mb-0">
            <thead class="table-light">
                <tr>
                    <th>Korisnik</th>
                    <th>Email</th>
                    <th>Datum registracije</th>
                    <th>Status</th>
                    <th class="text-end">Akcije</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var korisnik in Model)
                {
                    <tr>
                        <td>
                            <div class="fw-bold">@korisnik.Ime @korisnik.Prezime</div>
                            <small class="text-muted">@korisnik.KorisnickoIme</small>
                        </td>
                        <td class="align-middle">@korisnik.Email</td>
                        <td class="align-middle">@korisnik.DatumRegistracije.ToString("dd.MM.yyyy.")</td>
                        <td class="align-middle">
                            @if (korisnik.StatusAktivan)
                            {
                                <span class="badge bg-success-subtle text-success">Aktivan</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary-subtle text-secondary">Neaktivan</span>
                            }
                        </td>
                        <td class="text-end align-middle">
                            <a asp-action="Details" asp-route-id="@korisnik.IdKorisnik" class="btn btn-outline-primary btn-sm">Detalji</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}