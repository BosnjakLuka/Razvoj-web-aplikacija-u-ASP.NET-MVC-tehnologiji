@model planinarenje.Models.ViewModels.KorisnikEditModel

<section class="mb-4">
    <h1 class="section-title mb-2">Uredi korisnika</h1>
    <p class="text-muted mb-0">Azurirajte podatke korisnika.</p>
</section>

<div class="app-card">
    <form asp-action="Edit" method="post">
        <div class="row">
            <div class="col-md-6 mb-3">
                <label asp-for="Ime" class="form-label"></label>
                <input asp-for="Ime" class="form-control" />
                <span asp-validation-for="Ime" class="text-danger small"></span>
            </div>
            <div class="col-md-6 mb-3">
                <label asp-for="Prezime" class="form-label"></label>
                <input asp-for="Prezime" class="form-control" />
                <span asp-validation-for="Prezime" class="text-danger small"></span>
            </div>
        </div>
        <div class="row">
            <div class="col-md-6 mb-3">
                <label asp-for="Email" class="form-label"></label>
                <input asp-for="Email" class="form-control" />
                <span asp-validation-for="Email" class="text-danger small"></span>
            </div>
            <div class="col-md-6 mb-3">
                <label asp-for="KorisnickoIme" class="form-label"></label>
                <input asp-for="KorisnickoIme" class="form-control" />
                <span asp-validation-for="KorisnickoIme" class="text-danger small"></span>
            </div>
        </div>
        <div class="row">
            <div class="col-md-6 mb-3">
                <label asp-for="BrojMobitela" class="form-label"></label>
                <input asp-for="BrojMobitela" class="form-control" />
                <span asp-validation-for="BrojMobitela" class="text-danger small"></span>
            </div>
            <div class="col-md-6 mb-3">
                <label asp-for="DatumRodenja" class="form-label"></label>
                <input asp-for="DatumRodenja" class="form-control" />
                <span asp-validation-for="DatumRodenja" class="text-danger small"></span>
            </div>
        </div>
        <div class="d-flex gap-2">
            <button type="submit" class="btn btn-primary">Spremi</button>
            <a asp-action="Index" class="btn btn-outline-secondary">Odustani</a>
        </div>
    </form>
</div>
