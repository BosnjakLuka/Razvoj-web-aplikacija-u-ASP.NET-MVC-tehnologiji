@page
@model ExternalLoginModel
@{
    ViewData["Title"] = "Dovrši registraciju";
}

<h1>@ViewData["Title"]</h1>
<h2 id="external-login-title">Povezivanje računa: @Model.ProviderDisplayName.</h2>
<hr />

<p id="external-login-description" class="text-info">
    Uspješno ste se autentificirali putem <strong>@Model.ProviderDisplayName</strong>.
    Molimo dovršite profil ispod (ime, prezime i korisničko ime) i kliknite „Dovrši registraciju"
    kako biste se prijavili.
</p>

<div class="row">
    <div class="col-md-4">
        <form asp-page-handler="Confirmation" asp-route-returnUrl="@Model.ReturnUrl" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
            <div class="form-floating mb-3">
                <input asp-for="Input.Ime" class="form-control" autocomplete="given-name" placeholder="Ime" />
                <label asp-for="Input.Ime"></label>
                <span asp-validation-for="Input.Ime" class="text-danger"></span>
            </div>
            <div class="form-floating mb-3">
                <input asp-for="Input.Prezime" class="form-control" autocomplete="family-name" placeholder="Prezime" />
                <label asp-for="Input.Prezime"></label>
                <span asp-validation-for="Input.Prezime" class="text-danger"></span>
            </div>
            <div class="form-floating mb-3">
                <input asp-for="Input.Email" class="form-control" autocomplete="email" placeholder="Please enter your email."/>
                <label asp-for="Input.Email" class="form-label"></label>
                <span asp-validation-for="Input.Email" class="text-danger"></span>
            </div>
            <div class="form-floating mb-3">
                <input asp-for="Input.KorisnickoIme" class="form-control" autocomplete="username" placeholder="Korisničko ime" />
                <label asp-for="Input.KorisnickoIme"></label>
                <span asp-validation-for="Input.KorisnickoIme" class="text-danger"></span>
            </div>
            <button type="submit" class="w-100 btn btn-lg btn-primary">Dovrši registraciju</button>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
